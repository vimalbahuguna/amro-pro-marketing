---
import Layout from '../layouts/Layout.astro';
import FeatureCard from '../components/FeatureCard.astro';
import OutcomesBar from '../components/OutcomesBar.astro';
import TrustRow from '../components/TrustRow.astro';
import { getCollection } from 'astro:content';

const features = (await getCollection('features')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout>
  {/* Hero — dark, purple accent */}
  <section class="relative isolate overflow-hidden bg-slate-950 text-white">
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-slate-950 via-slate-950 to-slate-900"></div>
    <div class="pointer-events-none absolute -left-32 -top-32 h-96 w-96 rounded-full bg-purple-500/20 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -right-32 top-1/3 h-96 w-96 rounded-full bg-purple-500/10 blur-3xl" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-6xl px-6 pt-24 pb-20 text-center sm:pt-32 sm:pb-28">
      <p class="text-xs font-medium uppercase tracking-[0.32em] text-purple-400">
        A product by SOS Services · 4 regulatory authorities
      </p>
      <h1 class="mx-auto mt-5 max-w-3xl text-4xl font-bold tracking-tight text-white sm:text-6xl">
        MRO software the regulator can actually read.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-300">
        Built for regional carriers and MRO operators who can't afford a seven-figure SAP
        rollout — but can't afford a missed inspection either. FAA, EASA, CAAC, and SACAA
        workflows are first-class, not bolted on.
      </p>
      <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="/contact"
          class="rounded-lg bg-purple-500 px-6 py-3 text-sm font-semibold text-slate-950 shadow-sm transition hover:bg-purple-400"
        >
          Join AMRO Pro pilot
        </a>
        <a
          href="#features"
          class="rounded-lg border border-slate-700 px-6 py-3 text-sm font-semibold text-slate-100 transition hover:border-slate-500 hover:bg-slate-900"
        >
          See the platform →
        </a>
      </div>
      <p class="mt-6 text-xs text-slate-500">
        FAA · EASA · CAAC · SACAA · Multi-tenant · Audit-ready
      </p>
    </div>
  </section>

  {/* Trust row */}
  <TrustRow />

  {/* Outcomes — regulator-readable */}
  <OutcomesBar />

  {/* Features grid */}
  <section id="features" class="mx-auto max-w-6xl px-6 py-20">
    <div class="mb-10 flex items-end justify-between">
      <div>
        <h2 class="text-3xl font-semibold tracking-tight">What's inside AMRO Pro</h2>
        <p class="mt-2 text-slate-600">
          Eight modules that connect a maintenance manual to a regulator-ready record.
        </p>
      </div>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((feature) => <FeatureCard feature={feature} />)}
    </div>
  </section>

  {/* Why */}
  <section class="border-t border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="text-3xl font-semibold tracking-tight">Why AMRO Pro instead of a 1990s MRO suite</h2>
      <dl class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        <div>
          <dt class="font-medium">Built for four regulators from day one</dt>
          <dd class="mt-2 text-sm text-slate-600">
            FAA, EASA, CAAC, SACAA. Not "FAA with a translation layer." Authority-aware
            forms, deadlines, sign-off chains.
          </dd>
        </div>
        <div>
          <dt class="font-medium">Provenance, not paperwork</dt>
          <dd class="mt-2 text-sm text-slate-600">
            Every task signed off has a digital chain — who, when, against which MPD
            revision, against which AD. Inspectors get evidence, not stapled binders.
          </dd>
        </div>
        <div>
          <dt class="font-medium">Multi-tenant, multi-MRO</dt>
          <dd class="mt-2 text-sm text-slate-600">
            Independent MROs serving multiple operators share a platform without sharing
            data. Each operator's records are their own.
          </dd>
        </div>
        <div>
          <dt class="font-medium">Parts traceability that holds up</dt>
          <dd class="mt-2 text-sm text-slate-600">
            Chain-of-custody from purchase order to installation, with airworthiness
            tags preserved. No more spreadsheets-of-truth that crumble during an audit.
          </dd>
        </div>
        <div>
          <dt class="font-medium">Modern engineering</dt>
          <dd class="mt-2 text-sm text-slate-600">
            Express microservice, React frontend, Postgres with RLS. The same stack
            powering modern SaaS — applied to a field that's been stuck on Oracle Forms.
          </dd>
        </div>
        <div>
          <dt class="font-medium">No license-by-airframe pricing</dt>
          <dd class="mt-2 text-sm text-slate-600">
            Per-tenant SaaS pricing. Add an aircraft, the math doesn't break. Add a
            regulator, the platform doesn't need a re-implementation.
          </dd>
        </div>
      </dl>
    </div>
  </section>

  {/* Pricing teaser */}
  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="rounded-2xl border border-slate-200 bg-white p-10 text-center">
      <p class="text-sm font-medium uppercase tracking-wider text-slate-500">Pricing</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight">Per-tenant, transparent, soon.</h2>
      <p class="mx-auto mt-4 max-w-xl text-slate-600">
        AMRO Pro is in closed pilot with regional carriers and independent MROs. Pricing
        tiers will publish here once we've validated them against real fleet sizes.
      </p>
      <a
        href="/contact"
        class="mt-6 inline-block rounded-lg bg-slate-900 px-5 py-2.5 text-sm font-medium text-white hover:bg-slate-800"
      >
        Request early access
      </a>
    </div>
  </section>

  {/* From the studio rail */}
  <section class="border-t border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div class="mb-8 flex items-end justify-between">
        <div>
          <p class="text-sm font-medium uppercase tracking-wider text-purple-700">From the studio</p>
          <h2 class="mt-2 text-2xl font-semibold tracking-tight">How we build AMRO Pro</h2>
        </div>
        <a
          href="https://sosservices.online/engineering/"
          class="hidden text-sm text-slate-600 hover:text-slate-900 sm:block"
          target="_blank"
          rel="noreferrer"
        >
          All engineering posts ↗
        </a>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        <a
          href="https://sosservices.online/engineering/when-an-mro-outgrows-spreadsheets/"
          class="block rounded-2xl border border-slate-200 bg-white p-6 transition hover:border-slate-300 hover:shadow-md"
          target="_blank"
          rel="noreferrer"
        >
          <p class="text-xs font-medium uppercase tracking-wider text-purple-700">MRO</p>
          <h3 class="mt-2 text-lg font-semibold tracking-tight text-slate-900">
            When an MRO outgrows spreadsheets
          </h3>
          <p class="mt-2 text-sm text-slate-600">
            The specific failure modes that arrive when work orders, parts, and
            airworthiness records all live in Excel. Why the next step usually isn't SAP.
          </p>
          <p class="mt-3 text-sm font-medium text-slate-900">Read on sosservices.online →</p>
        </a>
        <a
          href="https://sosservices.online/engineering/multi-tenant-rls-at-studio-scale/"
          class="block rounded-2xl border border-slate-200 bg-white p-6 transition hover:border-slate-300 hover:shadow-md"
          target="_blank"
          rel="noreferrer"
        >
          <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Engineering</p>
          <h3 class="mt-2 text-lg font-semibold tracking-tight text-slate-900">
            Multi-tenant RLS at studio scale
          </h3>
          <p class="mt-2 text-sm text-slate-600">
            How AMRO Pro isolates MRO operators sharing a platform. The 905-migration
            drift incident. The zombie connections that blocked an ALTER TABLE.
          </p>
          <p class="mt-3 text-sm font-medium text-slate-900">Read on sosservices.online →</p>
        </a>
        <a
          href="https://aviation.sosservices.online"
          class="block rounded-2xl border border-red-200 bg-red-50/40 p-6 transition hover:border-red-300 hover:shadow-md"
          target="_blank"
          rel="noreferrer"
        >
          <p class="text-xs font-medium uppercase tracking-wider text-red-700">Sibling product</p>
          <h3 class="mt-2 text-lg font-semibold tracking-tight text-slate-900">
            Aviation AI Pro — flight data analytics
          </h3>
          <p class="mt-2 text-sm text-slate-600">
            ARINC 717 parsing, multi-vendor DLU decoding, approach scoring, DGCA-ready
            exports. AMRO's safety-data cousin in the studio.
          </p>
          <p class="mt-3 text-sm font-medium text-slate-900">Visit aviation.sosservices.online →</p>
        </a>
        <a
          href="https://sthira.sosservices.online"
          class="block rounded-2xl border border-emerald-200 bg-emerald-50/40 p-6 transition hover:border-emerald-300 hover:shadow-md"
          target="_blank"
          rel="noreferrer"
        >
          <p class="text-xs font-medium uppercase tracking-wider text-emerald-700">Sibling product</p>
          <h3 class="mt-2 text-lg font-semibold tracking-tight text-slate-900">
            Sthira — retail investing, built calm
          </h3>
          <p class="mt-2 text-sm text-slate-600">
            Goal-based SIPs and pre-authorized rebalancing for layman investors. The LLM
            explains. It never trades.
          </p>
          <p class="mt-3 text-sm font-medium text-slate-900">Visit sthira.sosservices.online →</p>
        </a>
      </div>
    </div>
  </section>
</Layout>
