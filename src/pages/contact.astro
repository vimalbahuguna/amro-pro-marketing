---
import Layout from '../layouts/Layout.astro';

const FORM_ENDPOINT = 'https://gzhxgoigflftharcmdqj.supabase.co/functions/v1/marketing-inquiry';
---

<Layout
  title="Request a demo — AMRO Pro"
  description="See AMRO Pro with your fleet's data — we'll set up a sandbox shaped like your operation so you can use the platform instead of watching a slide deck."
>
  <section class="mx-auto max-w-2xl px-6 py-20">
    <p class="text-sm font-medium uppercase tracking-wider text-purple-700">Demo</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight">See it with your fleet.</h1>
    <p class="mt-4 text-slate-600">
      AMRO Pro is in closed pilot. Tell us a little about your operation and we'll set
      up a sandbox with synthetic data shaped like yours, so you can actually use the
      platform instead of watching a slide deck.
    </p>

    <form
      id="contact-form"
      data-endpoint={FORM_ENDPOINT}
      class="mt-10 space-y-5"
      novalidate
    >
      {/* Honeypot */}
      <input
        type="text"
        name="website"
        autocomplete="off"
        tabindex="-1"
        class="absolute left-[-9999px] h-0 w-0 opacity-0"
        aria-hidden="true"
      />

      <div>
        <label for="name" class="block text-sm font-medium">Your name</label>
        <input
          id="name"
          name="name"
          type="text"
          required
          maxlength="200"
          class="mt-1 w-full rounded-md border border-slate-200 px-3 py-2 text-sm focus:border-purple-500 focus:outline-none"
        />
      </div>
      <div>
        <label for="email" class="block text-sm font-medium">Work email</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          maxlength="200"
          class="mt-1 w-full rounded-md border border-slate-200 px-3 py-2 text-sm focus:border-purple-500 focus:outline-none"
        />
      </div>
      <div>
        <label for="company" class="block text-sm font-medium">Organization</label>
        <input
          id="company"
          name="company"
          type="text"
          maxlength="200"
          class="mt-1 w-full rounded-md border border-slate-200 px-3 py-2 text-sm focus:border-purple-500 focus:outline-none"
          placeholder="Airline, MRO, regulator, or fleet operator"
        />
      </div>
      <div>
        <label for="role" class="block text-sm font-medium">What's your role?</label>
        <select
          id="role"
          name="role"
          class="mt-1 w-full rounded-md border border-slate-200 px-3 py-2 text-sm focus:border-purple-500 focus:outline-none"
        >
          <option value="maintenance">Maintenance / engineering</option>
          <option value="quality">Quality / airworthiness</option>
          <option value="operations">Operations</option>
          <option value="regulator">Regulator</option>
          <option value="executive">Executive / decision maker</option>
          <option value="it">IT / systems</option>
          <option value="other">Something else</option>
        </select>
      </div>
      <div>
        <label for="message" class="block text-sm font-medium">What MRO challenge are you working on?</label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          maxlength="5000"
          class="mt-1 w-full rounded-md border border-slate-200 px-3 py-2 text-sm focus:border-purple-500 focus:outline-none"
          placeholder="e.g., we run 22 aircraft across two AOCs, spreadsheets for AD compliance, paper sign-offs, inspector coming in Q3."
        ></textarea>
      </div>
      <button
        type="submit"
        id="contact-submit"
        class="rounded-lg bg-purple-700 px-5 py-2.5 text-sm font-medium text-white hover:bg-purple-600 disabled:opacity-60 disabled:cursor-not-allowed"
      >
        Request demo
      </button>

      <div
        id="contact-feedback"
        class="hidden rounded-md border px-4 py-3 text-sm"
        role="status"
        aria-live="polite"
      ></div>

      <p class="text-xs text-slate-500">
        We don't use your email for marketing without an explicit opt-in.
      </p>
    </form>

    <div class="mt-12 border-t border-slate-200 pt-6 text-sm text-slate-600">
      Prefer email? Reach us at{' '}
      <a href="mailto:hello@sosservices.online" class="text-slate-900 underline">
        hello@sosservices.online
      </a>
      .
    </div>
  </section>

  <script is:inline>
    (() => {
      const form = document.getElementById('contact-form');
      if (!form) return;
      const endpoint = form.dataset.endpoint;
      const submit = document.getElementById('contact-submit');
      const feedback = document.getElementById('contact-feedback');

      const showFeedback = (kind, msg) => {
        feedback.textContent = msg;
        feedback.className = `rounded-md border px-4 py-3 text-sm ${
          kind === 'ok'
            ? 'border-emerald-200 bg-emerald-50 text-emerald-700'
            : 'border-rose-200 bg-rose-50 text-rose-700'
        }`;
      };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        submit.disabled = true;
        const originalLabel = submit.textContent;
        submit.textContent = 'Sending…';

        const data = Object.fromEntries(new FormData(form).entries());

        try {
          const res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
          });
          const json = await res.json().catch(() => ({}));
          if (res.ok) {
            showFeedback('ok', "Thanks! We'll be in touch within two business days to set up your demo.");
            form.reset();
          } else {
            showFeedback('err', json.error || 'Something went wrong. Please email us directly.');
          }
        } catch {
          showFeedback('err', 'Network error. Please email us directly.');
        } finally {
          submit.disabled = false;
          submit.textContent = originalLabel;
        }
      });
    })();
  </script>
</Layout>
