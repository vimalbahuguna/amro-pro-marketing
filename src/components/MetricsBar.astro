---
const metrics = [
  { value: '4', label: 'Regulatory authorities', sub: 'FAA · EASA · CAAC · SACAA' },
  { value: '8', label: 'Integrated modules', sub: 'MPD → work orders → exports' },
  { value: '100%', label: 'Task-level sign-off', sub: 'every step traceable' },
  { value: '0', label: 'Vendor lock-in', sub: 'open schema, exportable' },
];
---

<section class="border-y border-slate-200 bg-white">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <p class="text-sm font-medium uppercase tracking-wider text-purple-700">
      Built for the inspector, not the salesman
    </p>
    <dl class="mt-6 grid grid-cols-2 gap-8 sm:grid-cols-4">
      {
        metrics.map((m) => (
          <div>
            <dt class="text-3xl font-semibold tracking-tight text-slate-900">{m.value}</dt>
            <dd class="mt-1 text-sm font-medium text-slate-900">{m.label}</dd>
            <dd class="mt-0.5 text-xs text-slate-500">{m.sub}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
