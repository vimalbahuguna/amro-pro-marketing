---
const badges = [
  { label: 'FAA · EASA · CAAC · SACAA', sub: 'multi-authority first-class' },
  { label: 'Built on Logic Nexus', sub: 'multi-tenant by inheritance' },
  { label: 'Audit trail per work order', sub: 'regulator-ready evidence bundles' },
  { label: 'Pilot Q3 2026', sub: 'in design with regional operators' },
];
---

<section class="border-b border-slate-800 bg-slate-950">
  <div class="motion-rise mx-auto max-w-6xl px-6 py-6">
    <p class="text-center text-[11px] font-medium uppercase tracking-[0.28em] text-slate-500">
      Built for the MRO floor, not for procurement
    </p>
    <ul role="list" class="mt-4 grid grid-cols-2 gap-4 text-center sm:grid-cols-4">
      {
        badges.map((b) => (
          <li>
            <p class="text-sm font-medium text-slate-200">{b.label}</p>
            <p class="mt-0.5 text-xs text-slate-500">{b.sub}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
